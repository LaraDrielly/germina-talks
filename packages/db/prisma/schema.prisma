generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum SchoolTrack {
  business
  tech
  factory
}

enum ScopeType {
  global
  classroom
}

enum MemberRole {
  student
  teacher
}

enum ContentStatus {
  pending
  approved
  rejected
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(student)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships ClassroomMember[]
  posts     Post[]
  bulletins BulletinItem[]
  albums    Album[]  @relation("AlbumCreatedBy")
  moderatedAlbums Album[] @relation("AlbumModeratedBy")
  uploadedPhotos Photo[] @relation("PhotoUploadedBy")
  moderatedPhotos Photo[] @relation("PhotoModeratedBy")

  @@map("users")
}

model Classroom {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  slug       String      @unique
  schoolTrack SchoolTrack @map("school_track")
  year       Int
  createdAt  DateTime    @default(now()) @map("created_at")
  memberships ClassroomMember[]
  posts      Post[]
  bulletins  BulletinItem[]
  albums     Album[]

  @@map("classrooms")
}

model ClassroomMember {
  userId      String     @db.Uuid @map("user_id")
  classroomId String     @db.Uuid @map("classroom_id")
  role        MemberRole @map("role_in_class")
  joinedAt    DateTime   @default(now()) @map("joined_at")
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom   Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([userId, classroomId])
  @@index([classroomId, role])
  @@map("classroom_members")
}

model Post {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @db.Uuid @map("author_id")
  content     String     @db.VarChar(280)
  scopeType   ScopeType  @map("scope_type")
  classroomId String?    @db.Uuid @map("classroom_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@index([classroomId, createdAt(sort: Desc)])
  @@index([scopeType, createdAt(sort: Desc)])
  @@map("posts")
}

model BulletinItem {
  id          String     @id @default(uuid()) @db.Uuid
  authorId    String     @db.Uuid @map("author_id")
  title       String     @db.VarChar(120)
  body        String     @db.Text
  isPinned    Boolean    @default(false) @map("is_pinned")
  scopeType   ScopeType  @map("scope_type")
  classroomId String?    @db.Uuid @map("classroom_id")
  expiresAt   DateTime?  @map("expires_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  author      User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  @@index([scopeType, classroomId, isPinned(sort: Desc), createdAt(sort: Desc)])
  @@map("bulletin_items")
}

model Album {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @db.VarChar(120)
  description String?       @db.Text
  scopeType   ScopeType     @map("scope_type")
  classroomId String?       @db.Uuid @map("classroom_id")
  createdBy   String        @db.Uuid @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  status      ContentStatus @default(pending)
  moderatedBy String?       @db.Uuid @map("moderated_by")
  moderatedAt DateTime?     @map("moderated_at")
  creator     User          @relation("AlbumCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  moderator   User?         @relation("AlbumModeratedBy", fields: [moderatedBy], references: [id], onDelete: SetNull)
  classroom   Classroom?    @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  photos      Photo[]

  @@index([scopeType, classroomId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("albums")
}

model Photo {
  id          String        @id @default(uuid()) @db.Uuid
  url         String        @db.VarChar(512)
  caption     String?       @db.VarChar(200)
  albumId     String        @db.Uuid @map("album_id")
  uploadedBy  String        @db.Uuid @map("uploaded_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  status      ContentStatus @default(pending)
  moderatedBy String?       @db.Uuid @map("moderated_by")
  moderatedAt DateTime?     @map("moderated_at")
  album       Album         @relation(fields: [albumId], references: [id], onDelete: Cascade)
  uploader    User          @relation("PhotoUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)
  moderator   User?         @relation("PhotoModeratedBy", fields: [moderatedBy], references: [id], onDelete: SetNull)

  @@index([albumId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("photos")
}
