generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  teacher
  admin
}

enum SchoolTrack {
  business
  tech
  factory
}

enum ScopeType {
  global
  classroom
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  role      UserRole @default(student)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdAlbums Album[] @relation("AlbumCreatedBy")
  moderatedAlbums Album[] @relation("AlbumModeratedBy")
  uploadedPhotos Photo[] @relation("PhotoUploadedBy")
  moderatedPhotos Photo[] @relation("PhotoModeratedBy")
  @@map("users")
}

model Classroom {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  slug       String      @unique
  schoolTrack SchoolTrack @map("school_track")
  year       Int
  createdAt  DateTime    @default(now()) @map("created_at")

  albums Album[]
  @@map("classrooms")
}

enum ContentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Album {
  id            String         @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  scope         ScopeType
  classroomId   String?        @db.Uuid
  classroom     Classroom?     @relation(fields: [classroomId], references: [id])
  createdById   String         @db.Uuid
  createdBy     User           @relation("AlbumCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  status        ContentStatus  @default(PENDING)
  moderatedById String?        @db.Uuid
  moderatedBy   User?          @relation("AlbumModeratedBy", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?      @map("moderated_at")
  photos        Photo[]

  @@map("albums")
}

model Photo {
  id            String         @id @default(uuid()) @db.Uuid
  url           String
  caption       String?
  albumId       String         @db.Uuid
  album         Album          @relation(fields: [albumId], references: [id])
  uploadedById  String         @db.Uuid
  uploadedBy    User           @relation("PhotoUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime       @default(now()) @map("created_at")
  status        ContentStatus  @default(PENDING)
  moderatedById String?        @db.Uuid
  moderatedBy   User?          @relation("PhotoModeratedBy", fields: [moderatedById], references: [id])
  moderatedAt   DateTime?      @map("moderated_at")

  @@map("photos")
}

